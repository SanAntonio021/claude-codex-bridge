{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.claude-codex-bridge/schemas/job-request.schema.json",
  "title": "Legacy protocol-v1 bridge job request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "idempotency_key",
    "origin",
    "target",
    "operation",
    "hop_count",
    "created_at",
    "deadline",
    "question",
    "route"
  ],
  "properties": {
    "request_id": { "type": "string", "format": "uuid" },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 128 },
    "origin": { "type": "string", "minLength": 1, "maxLength": 64 },
    "target": { "enum": ["claude", "codex"] },
    "operation": { "enum": ["ask", "task", "review_repair"] },
    "reviewer_access": { "enum": ["read_only", "isolated_write"] },
    "hop_count": { "type": "integer", "minimum": 0, "maximum": 2 },
    "ancestor_request_ids": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "deadline": { "type": "string", "format": "date-time" },
    "question": { "type": "string", "minLength": 1 },
    "context": { "type": "string" },
    "route": { "enum": ["auto", "headless", "live"] },
    "target_session_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "bridge_thread_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "allow_fresh_fallback": { "type": "boolean" },
    "artifact_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "artifact_type": { "enum": ["plan", "deliverable"] },
    "author": { "enum": ["Codex", "Claude"] },
    "reviewer": { "enum": ["Claude Opus 5", "Claude Opus 4.6", "Claude Sonnet 5", "Codex"] },
    "artifact_name": { "type": "string", "minLength": 1, "maxLength": 512 },
    "artifact_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "artifact_bytes": { "type": "integer", "minimum": 0 },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact_content": { "type": "string", "minLength": 1, "maxLength": 900000 },
    "target_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "round": { "type": "integer", "minimum": 1, "maximum": 3 },
    "max_rounds": { "const": 3 },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "test_commands": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[A-Za-z0-9_.:\\\\/@=+\\-]+(?: [A-Za-z0-9_.:\\\\/@=+\\-]+)*$"
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
    },
    "prior_rounds": { "type": "array", "maxItems": 3, "items": { "type": "object" } },
    "prior_findings": { "type": "array", "maxItems": 256, "items": { "type": "string" } },
    "open_items": { "type": "array", "maxItems": 256, "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "ask" } }, "required": ["operation"] },
      "then": { "properties": { "reviewer_access": { "const": "read_only" } } }
    },
    {
      "if": { "properties": { "operation": { "const": "task" } }, "required": ["operation"] },
      "then": { "required": ["artifact_id", "target_root", "allowed_paths"] }
    },
    {
      "if": { "properties": { "operation": { "const": "review_repair" } }, "required": ["operation"] },
      "then": {
        "required": [
          "reviewer_access",
          "artifact_id",
          "artifact_type",
          "author",
          "reviewer",
          "artifact_name",
          "artifact_bytes",
          "artifact_sha256",
          "artifact_content",
          "target_root",
          "allowed_paths",
          "round",
          "max_rounds",
          "acceptance_criteria",
          "test_commands"
        ],
        "properties": { "reviewer_access": { "const": "isolated_write" } }
      }
    }
  ]
}
